<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileAppTest.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#8B3D68</Color>
            <Color x:Key="PrimaryDark">#642B4C</Color>
            <Color x:Key="Accent">#D89AB7</Color>
            <Color x:Key="PageBackground">#FAF7F9</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#241C21</Color>
            <Color x:Key="TextSecondary">#756A71</Color>
            <Color x:Key="Danger">#C94B5A</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
