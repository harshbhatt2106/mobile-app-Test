<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileAppTest.MainPage"
             BackgroundColor="#F7F5F8"
             Title="ShadiConnect">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BackgroundColor="#7A2856"
                StrokeThickness="0"
                Padding="22,24,22,26">
            <VerticalStackLayout Spacing="5">
                <Label Text="ShadiConnect"
                       TextColor="White"
                       FontSize="30"
                       FontAttributes="Bold" />
                <Label Text="Members"
                       TextColor="#F4DDE9"
                       FontSize="14" />
                <Label x:Name="CountLabel"
                       Text="0 profiles"
                       TextColor="White"
                       FontSize="21"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1"
                     x:Name="RefreshView"
                     Refreshing="OnRefresh">
            <CollectionView x:Name="UsersCollection"
                            Margin="16,18"
                            SelectionMode="None">
                <CollectionView.Header>
                    <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,14">
                        <Label Text="Profiles"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#252129"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Clicked="OnRefreshClicked"
                                BackgroundColor="#EFE3EA"
                                TextColor="#7A2856"
                                CornerRadius="18"
                                Padding="16,0"
                                HeightRequest="38" />
                    </Grid>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30,70"
                                         Spacing="10"
                                         HorizontalOptions="Center">
                        <Label Text="No profiles found"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="The GET API returned no members."
                               TextColor="#756D74"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="#E8E1E5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid ColumnDefinitions="52,*" ColumnSpacing="14">
                                <Border BackgroundColor="#F0E0E9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 26"
                                        WidthRequest="52"
                                        HeightRequest="52">
                                    <Label Text="{Binding Name}"
                                           TextColor="#7A2856"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#252129" />
                                    <Label Text="{Binding Email}"
                                           FontSize="13"
                                           TextColor="#756D74" />
                                    <Label Text="{Binding Age, StringFormat='Age {0}'}"
                                           FontSize="13"
                                           TextColor="#7A2856" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
